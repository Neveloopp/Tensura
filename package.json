    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "bench": "node --import tsx scripts/benchmark.ts",
    "bench:load": "node --import tsx scripts/loadtime.ts"
  },
  "keywords": [
    "whatsapp-bot",
    "baileys",
    "tensura",
    "stickers",
    "downloads"
  ],
  "author": "Tensura",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "file:vendor/baileys-7.0.0-rc14-tensura.1.tgz",
    "axios": "^1.7.9",
    "boxen": "^8.0.1",
    "cfonts": "^3.3.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "moment-timezone": "^0.5.46",
    "node-webpmux": "^3.2.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.2",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
