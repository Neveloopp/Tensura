# ─────────────────────────────────────────────
#  TENSURA · configuración rápida
#  Copia este archivo como .env y edita tus datos
# ─────────────────────────────────────────────

# Dueño(s) del bot. Separa varios números con coma (solo dígitos, con código de país)
OWNER_NUMBER=50585117242

# Identidad
BOT_NAME=Tensura
BOT_NAME2=Tensura MD
BOT_LINK=https://github.com/Neveloopp
BANNER_URL=
CHANNEL_ID=
CHANNEL_NAME=Tensura
TIMEZONE=America/Havana

# Prefijos separados por coma
PREFIXES=#,/,.,!

# Sesión de WhatsApp
SESSION_NAME=Sessions/Tensura
# qr = escanear código | code = código de 8 dígitos | vacío = preguntar al iniciar
WA_CONNECTION_METHOD=
WA_PHONE_NUMBER=

# Stickers
STICKER_PACK=Tensura
STICKER_AUTHOR=Tensura Bot
STICKER_AUDIO_MAX=25

# Descargas
DOWNLOAD_MAX_MB=100

# Base de datos (ms de debounce antes de escribir el JSON)
DB_PERSIST_MS=250

# Sub bots
SUBBOT_DATA_FILE=database/subbots.json
SUBBOT_SESSION_DIR=Sessions/SubBots
SUBBOT_FOLLOW_CHANNEL=120363414217688890@newsletter
SUBBOT_PAIRING_TTL_MS=180000
SUBBOT_SUPERVISOR_MS=30000

# Panel web de sub bots: con 1 activo, cualquiera puede registrarse
SUBBOT_WEB_ENABLED=0
SUBBOT_WEB_HOST=0.0.0.0
SUBBOT_WEB_PORT=3000
SUBBOT_WEB_ACCOUNTS_FILE=database/web-accounts.json
SUBBOT_WEB_SESSIONS_FILE=database/web-sessions.json
# Cuenta administradora opcional: define ambos valores
SUBBOT_WEB_PHONE=
SUBBOT_WEB_PASSWORD=

# APIs (configura tus propias claves)
EVOGB_API_KEY=
RAYLAIS_API_KEY=
LEMPI_API_KEY=

# IA (OpenRouter) para el comando .ia
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_MAX_TOOL_ROUNDS=4

# Actualización desde GitHub (#sync)
# SYNC_DIR deja vacío para usar el proyecto actual; si no es un clon git,
# #sync pull descarga el ZIP de SYNC_REPO y actualiza los archivos.
SYNC_DIR=
SYNC_REPO=Neveloopp/Tensura
SYNC_BRANCH=main
SYNC_WATCH=1
TENSURA_AUTO_RESTART=1
# Token con permiso de escritura para #sync push. No lo compartas.
GITHUB_TOKEN=
