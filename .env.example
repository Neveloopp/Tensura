# ─────────────────────────────────────────────
#  TENSURA · configuración rápida
#  Copia este archivo como .env y edita tus datos
# ─────────────────────────────────────────────

# Dueño(s) del bot. Separa varios números con coma (solo dígitos, con código de país)
OWNER_NUMBER=50585117242

# Identidad
BOT_NAME=Tensura
BOT_NAME2=Tensura MD
BOT_LINK=https://github.com/Neveloopp
BANNER_URL=
CHANNEL_ID=
CHANNEL_NAME=Tensura
TIMEZONE=America/Havana

# Prefijos separados por coma
PREFIXES=#,/,.,!

# Sesión de WhatsApp
SESSION_NAME=Sessions/Tensura
# qr = escanear código | code = código de 8 dígitos | vacío = preguntar al iniciar
WA_CONNECTION_METHOD=
WA_PHONE_NUMBER=

# Stickers
STICKER_PACK=Tensura
STICKER_AUTHOR=Tensura Bot
STICKER_AUDIO_MAX=25

# Descargas
DOWNLOAD_MAX_MB=100

# Base de datos (ms de debounce antes de escribir el JSON)
DB_PERSIST_MS=250

# APIs (configura tus propias claves)
EVOGB_API_KEY=
RAYLAIS_API_KEY=
LEMPI_API_KEY=
